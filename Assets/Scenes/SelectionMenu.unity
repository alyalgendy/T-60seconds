  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SelectionMenuController
  options:
  - title: FLIGHT
    description: Call the final go or no-go. You hold the count, the loop, and the last word before liftoff.
  - title: GUIDANCE
    description: Watch the trajectory. If the vehicle drifts in the final minute, you steer it back on course.
  - title: PROPULSION
    description: Monitor engines and tanks from ignition through the moment the stack leaves the pad.
  - title: RANGE SAFETY
    description: Guard the range. If the path breaks the safety lines, you make the abort call.
